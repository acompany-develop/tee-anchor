# ==============================================================================
# TEE Anchor のビルド成果物
# ==============================================================================
/tee-anchor
*.o
*.a
*.so

# ==============================================================================
# 実行時データ (組織 CA 秘密鍵を含むため絶対にコミットしないこと)
# ==============================================================================
/runtime/

# ==============================================================================
# 過去のテスト時に残存していた SGX Quote
# ==============================================================================
/provision/sgx/quote.dat

# ==============================================================================
# provision/sgx/sgx_sample のビルド成果物
# (sgx_sample は独立した Makefile を持つサブプロジェクト)
# ==============================================================================
/provision/sgx/sgx_sample/sample_app
/provision/sgx/sgx_sample/enclave.so
/provision/sgx/sgx_sample/enclave.signed.so
/provision/sgx/sgx_sample/quote.dat
# Edger8r が自動生成する untrusted / trusted のエッジ関数ソース
/provision/sgx/sgx_sample/App/sample_enclave_u.c
/provision/sgx/sgx_sample/App/sample_enclave_u.h
/provision/sgx/sgx_sample/App/*.o
/provision/sgx/sgx_sample/Enclave/sample_enclave_t.c
/provision/sgx/sgx_sample/Enclave/sample_enclave_t.h
/provision/sgx/sgx_sample/Enclave/*.o
# Makefile が自動生成する Enclave 署名鍵
/provision/sgx/sgx_sample/Enclave/private_key.pem

# ==============================================================================
# provision/sev-snp/snp-sample の生成物
# (report.bin は実機固有の Attestation Report、certs/ は KDS から取得した
#  VCEK チェーン。いずれも get_attestation.sh で再生成できる)
# ==============================================================================
/provision/sev-snp/snp-sample/report.bin
/provision/sev-snp/snp-sample/request-data.txt
/provision/sev-snp/snp-sample/certs/

# ==============================================================================
# provision/tdx/tdx_sample の生成物
# (get_quote は libtdx_attest にリンクするバイナリ、quote.dat は実機固有の TD Quote。
#  いずれも make / ./get_quote で再生成できる)
# ==============================================================================
/provision/tdx/tdx_sample/get_quote
/provision/tdx/tdx_sample/quote.dat

# ==============================================================================
# provision/cca/cca_sample の生成物
# (RME スタックは setup.sh が $CCA_WORKSPACE(既定 $HOME/cca) に作るのでリポジトリ外。
#  ここでは Realm から取り出した token の中間物だけ無視する)
# ==============================================================================
/provision/cca/cca_sample/cca-token.cbor
/provision/cca/cca_sample/cca-token.b64
/provision/cca/cca_sample/*.cbor

# ==============================================================================
# エディタ / OS 固有
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ==============================================================================
# その他
# ==============================================================================
cca-ra-doc.pdf